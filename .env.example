# MediBrief は既定でAPIキー不要（ブラウザ内のルールベース整理）で動きます。
# このファイルは、あとからAIに差し替えるときのためのものです。
# 使うときは .env.local にコピーしてください。

# 整理ロジックの選択: rule（既定・端末内で完結） / api（/api/organize を経由）
NEXT_PUBLIC_MEMO_PROVIDER=rule

# NEXT_PUBLIC_MEMO_PROVIDER=api のときに使う。未設定ならサーバー側でルールベースに戻します。
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini
